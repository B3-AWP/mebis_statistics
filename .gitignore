# Configuration files with sensitive data
config/.env
config/exclude_names.txt
*.local.conf

# Temporary and generated files
temp.html
config.json
activities_data.json
prompt.txt
auswertung.html

# Export data
export/*

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
Referenzprojekt/
.claude/settings.local.json

# Logs
*.log
logs/
