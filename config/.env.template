# Mebis Statistik Dashboard - Environment Configuration Template
# Kopiere diese Datei zu .env und trage deine echten Werte ein
# Die .env Datei wird NICHT in Git eingecheckt (ist in .gitignore)

# ============================================================
# ZENTRALE ENVIRONMENT-EINSTELLUNGEN
# Diese Einstellungen gelten für Backend UND Frontend!
# ============================================================

# Flask Environment: production oder development
#   - production: Nur wichtige Logs, optimiert für Produktivbetrieb
#   - development: Alle Debug-Logs, ausführliche Fehlerausgaben
FLASK_ENV=production

# Flask Debug Mode: True oder False
#   - True: Flask Debug-Modus (Auto-Reload, detaillierte Errors)
#   - False: Production-Modus (stabil, keine Debug-Infos)
FLASK_DEBUG=False

# Log Level: DEBUG, INFO, WARN, ERROR
#   - DEBUG: Alle Logs (sehr detailliert, nur für Entwicklung)
#   - INFO: Wichtige Informationen und Warnungen
#   - WARN: Nur Warnungen und Fehler
#   - ERROR: Nur kritische Fehler
LOG_LEVEL=INFO

# Flask Server Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================
# MEBIS LOGIN CREDENTIALS (ERFORDERLICH!)
# ============================================================
MEBIS_USERNAME=your_username_here
MEBIS_PASSWORD=your_password_here

# ============================================================
# SELENIUM MODE
# ============================================================
# Headless Mode: True oder False (Browser unsichtbar ausführen)
MODE_HEADLESS=True

# Wait Time in Sekunden (Wartezeit zwischen Seitenladeoperationen)
MODE_WAITTIME=1

# ============================================================
# MEBIS URLs
# ============================================================
MEBIS_BASE_URL=https://lernplattform.mebis.bycs.de/report/progress/index.php
MEBIS_COMMON_PARAMS=&sifirst=&activityorder=orderincourse&activitysection=-1

# ============================================================
# COURSE CONFIGURATION (ERFORDERLICH!)
# ============================================================
# Die Mebis Kurs-ID findest du in der URL deines Kurses
MEBIS_COURSE_ID=2036416

# ============================================================
# EXPORT CONFIGURATION
# ============================================================
# Ordner für Export-Dateien (relativ zum Projektverzeichnis)
# Hier werden die JSON-Dateien von exportData.py gespeichert
EXPORT_FOLDER=export

# ============================================================
# IGNORED GROUPS (kommasepariert)
# ============================================================
# Gruppen die im Dashboard nicht angezeigt werden sollen
# Beispiel: MEBIS_IGNORED_GROUPS=IT_Lehrkraft,Test Team,Demo Gruppe
MEBIS_IGNORED_GROUPS=IT_Lehrkraft

# ============================================================
# GRADE MAPPING (JSON Format)
# ============================================================
# Definiert die Bewertungsstufen für Aufgaben
# Format: {"punkte": "bewertung", ...}
GRADE_MAPPING={
    "0": "* Nicht akzeptabel", 
    "70": "** Verbesserungsbedarf", 
    "100": "*** Solide Umsetzung", 
    "130": "**** Exzellent"
    }

# ============================================================
# LOGGING (optional)
# ============================================================
# Log-Datei Pfad (leer lassen für nur Console-Output)
# LOG_FILE=logs/dashboard.log

# Maximale Log-Datei Größe in Bytes (Standard: 10MB)
# LOG_MAX_BYTES=10485760

# Anzahl der Backup-Log-Dateien (Standard: 5)
# LOG_BACKUP_COUNT=5