# ============================================================
# LOGGING (optional)
# ============================================================
# Log-Datei Pfad (leer lassen für nur Console-Output)
# LOG_FILE=logs/dashboard.log

# Maximale Log-Datei Größe in Bytes (Standard: 10MB)
# LOG_MAX_BYTES=10485760

# Anzahl der Backup-Log-Dateien (Standard: 5)
# LOG_BACKUP_COUNT=5