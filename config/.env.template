# Mebis Statistik Dashboard - Environment Configuration Template
# Kopiere diese Datei zu .env und trage deine echten Werte ein
# Die .env Datei wird NICHT in Git eingecheckt (ist in .gitignore)

# ============================================================
# ZENTRALE ENVIRONMENT-EINSTELLUNGEN
# Diese Einstellungen gelten für Backend UND Frontend!
# ============================================================

# Flask Environment: production oder development
#   - production: Nur wichtige Logs, optimiert für Produktivbetrieb
#   - development: Alle Debug-Logs, ausführliche Fehlerausgaben
FLASK_ENV=production

# Flask Debug Mode: True oder False
#   - True: Flask Debug-Modus (Auto-Reload, detaillierte Errors)
#   - False: Production-Modus (stabil, keine Debug-Infos)
FLASK_DEBUG=False

# Log Level: DEBUG, INFO, WARN, ERROR
#   - DEBUG: Alle Logs (sehr detailliert, nur für Entwicklung)
#   - INFO: Wichtige Informationen und Warnungen
#   - WARN: Nur Warnungen und Fehler
#   - ERROR: Nur kritische Fehler
LOG_LEVEL=INFO

# Flask Server Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================
# MEBIS LOGIN CREDENTIALS (ERFORDERLICH!)
# ============================================================
MEBIS_USERNAME=your_username_here
MEBIS_PASSWORD=your_password_here

# ============================================================
# SELENIUM MODE
# ============================================================
# Headless Mode: True oder False (Browser unsichtbar ausführen)
MODE_HEADLESS=True

# Wait Time in Sekunden (Wartezeit zwischen Seitenladeoperationen)
MODE_WAITTIME=5

# ============================================================
# MEBIS URLs
# ============================================================
MEBIS_BASE_URL=https://lernplattform.bycs.de/report/progress/index.php
MEBIS_COMMON_PARAMS=&sifirst=&activityorder=orderincourse&activitysection=-1

# ============================================================
# COURSE CONFIGURATION (ERFORDERLICH!)
# ============================================================
# Die Mebis Kurs-ID findest du in der URL deines Kurses
MEBIS_COURSE_ID=2036416

# ============================================================
# EXPORT CONFIGURATION
# ============================================================
# Ordner für Export-Dateien (relativ zum Projektverzeichnis)
# Hier werden die JSON-Dateien von exportData.py gespeichert
EXPORT_FOLDER=export

# ============================================================
# IGNORED GROUPS (kommasepariert)
# ============================================================
# Gruppen die im Dashboard nicht angezeigt werden sollen
# Beispiel: MEBIS_IGNORED_GROUPS=IT_Lehrkraft,Test Team,Demo Gruppe
MEBIS_IGNORED_GROUPS=IT_Lehrkraft

# ============================================================
# SCHOOL WEEKS CONFIGURATION
# ============================================================
# Maximale Anzahl der Schulwochen für Fortschrittsberechnungen
# Diese Zahl wird verwendet um zu berechnen, wie viele Checklisten/Aufgaben
# in welcher Woche erwartet werden (z.B. bei 9 Wochen und 23 Checklisten
# werden in Woche 9 alle 23 Checklisten erwartet)
MAX_SCHOOLWEEKS=9

# ============================================================
# GRADE MAPPING (JSON Format)
# ============================================================
# Definiert die Bewertungsstufen für Aufgaben
# Format: {"punkte": "bewertung", ...}
GRADE_MAPPING={
    "0": "* Nicht akzeptabel", 
    "70": "** Verbesserungsbedarf", 
    "100": "*** Solide Umsetzung", 
    "130": "**** Exzellent"
    }

# ============================================================
# LETZTE ABGABEN KONFIGURATION
# ============================================================
# Zeitfenster in Kalendertagen: Abgaben innerhalb dieser Tage werden in der
# Tabelle "Letzte Abgaben je Gruppe" angezeigt.
RECENT_SUBMISSION_DAYS=5

# Ab wie vielen Schultagen ohne Abgabe eine Gruppe als "Inaktiv" markiert wird
INACTIVE_THRESHOLD_DAYS=14

# ============================================================
# MITARBEITSNOTEN KONFIGURATION (optional)
# ============================================================
# Klassen-zu-Schiene Zuordnung (JSON)
# Definiert welche Klasse zu welcher "Schiene" gehört (bestimmt Terminplan & Referenzdaten)
# CLASS_TO_TRACK={"IFA12A": "Schiene1", "IFA12C": "Schiene1", "IFA12E": "Schiene1", "IFA12B": "Schiene3", "IFA12D": "Schiene3"}

# Referenzwoche (Schulwoche) in der die 1. Mitarbeitsnote vergeben wurde
# MITARBEITSNOTE1_REFERENCE_WEEK=4

# Datum ab dem Bewertungen für die 2. Mitarbeitsnote zählen (pro Schiene, JSON)
# Bewertungen MIT submission_time NACH diesem Datum zählen für 2. MA Qualität
# REFERENZTERMIN_MITARBEITSNOTE1={"Schiene1": "2025-12-10", "Schiene3": "2026-01-08"}

# Assignment-IDs für Prognose-Komponenten (JSON, null = Komponente deaktiviert)
# PROGNOSIS_ASSIGNMENTS={"reviewTalk1": 77140327, "reviewTalk2": 83500375, "codeReview": 80560819}

